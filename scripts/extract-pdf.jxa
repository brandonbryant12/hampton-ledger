ObjC.import('Foundation');ObjC.import('PDFKit');
var env=$.NSProcessInfo.processInfo.environment;
var root=ObjC.unwrap(env.objectForKey('HAMPTON_ROOT'));
var doc=$.PDFDocument.alloc.initWithURL($.NSURL.fileURLWithPath(root+'/artifacts/hampton-annual-report-2024.pdf'));
var pages=[];var excerpt=$.PDFDocument.alloc.init;
for(var i=0;i<doc.pageCount;i++){
 var page=doc.pageAtIndex(i);var text=ObjC.unwrap(page.string)||'';
 pages.push({page:i+1,text:text});
 if(i>100&&(text.indexOf('Report of the Finance Department')>=0||text.indexOf('Total for Department:')>=0))excerpt.insertPageAtIndex(page,excerpt.pageCount);
}
$(JSON.stringify(pages)).writeToFileAtomicallyEncodingError(root+'/artifacts/annual-pages.json',true,$.NSUTF8StringEncoding,null);
excerpt.writeToFile(root+'/public/sources/hampton-2024-finance-excerpt.pdf');
JSON.stringify({pages:pages.length,excerptPages:excerpt.pageCount});